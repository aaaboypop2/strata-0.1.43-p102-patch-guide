+// a stage's own GPU for a chunk: waits while another stage has it as a helper (at most one of its layers)
+static void stage_acquire(std::atomic<int>& busy, std::atomic<bool>& want) {
+    int z = 0;
+    if (busy.compare_exchange_strong(z, 1)) return;
